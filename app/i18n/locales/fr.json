						"card": "@:components.atoms.Buttons.ArchiveButton.label la carte {name}"
					}
				},
				"UnarchiveButton": {
					"label": "Désarchiver",
					"ariaLabel": {
						"board": "@:components.atoms.Buttons.UnarchiveButton.label le tableau {name}",
