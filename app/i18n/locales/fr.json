{
	"global": {
		"appName": "gitlo.app"
	},
	"components": {
		"atoms": {
			"Buttons": {
				"ArchiveButton": {
					"label": "Archiver",
					"ariaLabel": {
						"board": "@:components.atoms.Buttons.ArchiveButton.label le tableau {name}",
