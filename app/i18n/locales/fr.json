{
	"global": {
		"appName": "gitlo.app"
	},
	"components": {
		"atoms": {
			"Buttons": {
				"ArchiveButton": {
					"label": "Archiver",
					"ariaLabel": {
						"board": "@:components.atoms.Buttons.ArchiveButton.label le tableau {name}",
						"column": "@:components.atoms.Buttons.ArchiveButton.label la colonne {name}",
						"card": "@:components.atoms.Buttons.ArchiveButton.label la carte {name}"
					}
				},
				"UnarchiveButton": {
					"label": "Désarchiver",
					"ariaLabel": {
						"board": "@:components.atoms.Buttons.UnarchiveButton.label le tableau {name}",
						"column": "@:components.atoms.Buttons.UnarchiveButton.label la colonne {name}",
						"card": "@:components.atoms.Buttons.UnarchiveButton.label la carte {name}"
					}
				},
				"CancelButton": {
					"label": "Annuler",
					"ariaLabel": {
						"board": "@:components.atoms.Buttons.CancelButton.label les modifications du tableau {name}",
						"column": "@:components.atoms.Buttons.CancelButton.label les modifications de la colonne {name}",
						"card": "@:components.atoms.Buttons.CancelButton.label les modifications de la carte {name}"
					}
				},
				"CloseButton": {
					"label": "Fermer",
					"ariaLabel": {
						"board": "@:components.atoms.Buttons.CloseButton.label le tableau {name}",
						"column": "@:components.atoms.Buttons.CloseButton.label la colonne {name}",
						"card": "@:components.atoms.Buttons.CloseButton.label la carte {name}"
					}
				},
				"DeleteButton": {
					"label": "Supprimer",
					"ariaLabel": {
						"board": "@:components.atoms.Buttons.DeleteButton.label le tableau {name}",
						"column": "@:components.atoms.Buttons.DeleteButton.label la colonne {name}",
						"card": "@:components.atoms.Buttons.DeleteButton.label la carte {name}"
					}
				},
				"EditButton": {
					"label": "Éditer",
					"ariaLabel": {
						"board": "@:components.atoms.Buttons.EditButton.label le tableau {name}",
						"column": "@:components.atoms.Buttons.EditButton.label la colonne {name}",
						"card": "@:components.atoms.Buttons.EditButton.label la carte {name}"
					}
				},
				"UpdateButton": {
					"label": "Mettre à jour",
					"ariaLabel": {
						"board": "@:components.atoms.Buttons.UpdateButton.label le tableau {name}",
						"column": "@:components.atoms.Buttons.UpdateButton.label la colonne {name}",
						"card": "@:components.atoms.Buttons.UpdateButton.label la carte {name}"
					}
				},
				"CreateBoardButton": {
					"label": "Créer un tableau",
					"ariaLabel": "@:components.atoms.Buttons.CreateBoardButton.label"
				},
				"LoadBoardButton": {
					"label": "Charger un tableau",
					"ariaLabel": "@:components.atoms.Buttons.LoadBoardButton.label"
				},
				"EditBoardButton": {
					"label": "Éditer le tableau",
					"ariaLabel": "@:components.atoms.Buttons.EditBoardButton.label"
				},
				"SaveBoardButton": {
					"label": "Enregistrer le tableau",
					"ariaLabel": "@:components.atoms.Buttons.SaveBoardButton.label"
				},
