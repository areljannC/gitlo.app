{
	"global": {
		"appName": "gitlo.app"
	},
	"components": {
		"atoms": {
			"Buttons": {
				"ArchiveButton": {
					"label": "Archiver",
					"ariaLabel": {
						"board": "@:components.atoms.Buttons.ArchiveButton.label le tableau {name}",
						"column": "@:components.atoms.Buttons.ArchiveButton.label la colonne {name}",
						"card": "@:components.atoms.Buttons.ArchiveButton.label la carte {name}"
					}
				},
				"UnarchiveButton": {
					"label": "Désarchiver",
					"ariaLabel": {
						"board": "@:components.atoms.Buttons.UnarchiveButton.label le tableau {name}",
						"column": "@:components.atoms.Buttons.UnarchiveButton.label la colonne {name}",
						"card": "@:components.atoms.Buttons.UnarchiveButton.label la carte {name}"
					}
				},
				"CancelButton": {
					"label": "Annuler",
					"ariaLabel": {
						"board": "@:components.atoms.Buttons.CancelButton.label les modifications du tableau {name}",
						"column": "@:components.atoms.Buttons.CancelButton.label les modifications de la colonne {name}",
						"card": "@:components.atoms.Buttons.CancelButton.label les modifications de la carte {name}"
					}
				}
			}
		}
	}
}
