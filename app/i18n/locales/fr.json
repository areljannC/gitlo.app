						"card": "@:components.atoms.Buttons.EditButton.label la carte {name}"
					}
				},
				"UpdateButton": {
					"label": "Mettre à jour",
					"ariaLabel": {
						"board": "@:components.atoms.Buttons.UpdateButton.label le tableau {name}",
