{
	"global": {
		"appName": "gitlo.app"
	},
	"components": {
		"atoms": {
			"Buttons": {
				"ArchiveButton": {
					"label": "Archivar",
					"ariaLabel": {
						"board": "@:components.atoms.Buttons.ArchiveButton.label tablero {name}",
						"column": "@:components.atoms.Buttons.ArchiveButton.label columna {name}",
						"card": "@:components.atoms.Buttons.ArchiveButton.label tarjeta {name}"
					}
				},
				"UnarchiveButton": {
					"label": "Desarchivar",
					"ariaLabel": {
						"board": "@:components.atoms.Buttons.UnarchiveButton.label tablero {name}",
						"column": "@:components.atoms.Buttons.UnarchiveButton.label columna {name}",
						"card": "@:components.atoms.Buttons.UnarchiveButton.label tarjeta {name}"
					}
				},
				"CancelButton": {
					"label": "Cancelar",
					"ariaLabel": {
						"board": "@:components.atoms.Buttons.CancelButton.label los cambios del tablero {name}",
						"column": "@:components.atoms.Buttons.CancelButton.label los cambios de la columna {name}",
						"card": "@:components.atoms.Buttons.CancelButton.label los cambios de la tarjeta {name}"
					}
				},
				"CloseButton": {
					"label": "Cerrar",
					"ariaLabel": {
						"board": "@:components.atoms.Buttons.CloseButton.label tablero {name}",
						"column": "@:components.atoms.Buttons.CloseButton.label columna {name}",
						"card": "@:components.atoms.Buttons.CloseButton.label tarjeta {name}"
					}
				},
				"DeleteButton": {
					"label": "Eliminar",
					"ariaLabel": {
						"board": "@:components.atoms.Buttons.DeleteButton.label el tablero {name}",
						"column": "@:components.atoms.Buttons.DeleteButton.label la columna {name}",
						"card": "@:components.atoms.Buttons.DeleteButton.label la tarjeta {name}"
					}
				},
				"EditButton": {
					"label": "Editar",
					"ariaLabel": {
						"board": "@:components.atoms.Buttons.EditButton.label el tablero {name}",
						"column": "@:components.atoms.Buttons.EditButton.label la columna {name}",
						"card": "@:components.atoms.Buttons.EditButton.label la tarjeta {name}"
					}
				},
				"UpdateButton": {
					"label": "Actualizar",
					"ariaLabel": {
						"board": "@:components.atoms.Buttons.UpdateButton.label el tablero {name}",
