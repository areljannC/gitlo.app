			"Buttons": {
				"ArchiveButton": {
					"label": "Archive",
					"ariaLabel": {
						"board": "@:components.atoms.Buttons.ArchiveButton.label board {name}",
						"column": "@:components.atoms.Buttons.ArchiveButton.label column {name}",
